---
interface Props {
  title: string;
  time: string;
  description: string;
}

// timeline-view animate-fade-in-right animate-range-rapid

const { title, time, description } = Astro.props;
---

<article class='flex flex-col items-center justify-start p-6 xl:w-95'>
  <span
    class='mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-[#97D3BC]/20'
    ><slot name='icon' /></span
  >
  <h3 class='text-primary mb-2 text-2xl leading-8 font-bold'>{title}</h3>
  <h4
    class='mb-4 text-xs leading-4 font-medium tracking-[1.2px] text-[#5D5F5F] uppercase'
  >
    {time}
  </h4>
  <p class='px-3 text-center text-base leading-6 text-[#5D5F5F] lg:text-lg'>
    {description}
  </p>
</article>
