---
interface Props {
  description: string;
}

// timeline-view animate-fade-in-left animate-range-rapid
const { description } = Astro.props;
---

<article
  class='flex flex-col items-center rounded-sm border border-solid border-[#DBDBDB] bg-white p-8 xl:w-95'
>
  <span class='pb-6'><slot name='icon' /></span>
  <h3 class='text-center text-base leading-7 text-black lg:text-lg'>
    {description}
  </h3>
</article>
