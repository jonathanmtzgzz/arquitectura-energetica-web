---
interface Props {
  rating: string;
  review: string;
  reviewer: string;
}

// timeline-view animate-fade-in-left animate-range-rapid

const { rating, review, reviewer } = Astro.props;
---

<article
  class='flex w-87.5 flex-col items-center justify-start rounded-sm border border-solid border-[#DBDBDB] bg-white shadow-lg lg:w-full xl:w-95'
>
  <span>Image</span>
  <div class='flex flex-col items-center justify-center p-8'>
    <span class='pb-4'>{rating}</span>
    <p class='px-6 pb-4 text-center text-base leading-6 text-black'>
      {review}
    </p>
    <p
      class='text-center text-xs leading-4 font-medium tracking-[1.2px] text-[#5D5F5F] uppercase'
    >
      {reviewer}
    </p>
  </div>
</article>
