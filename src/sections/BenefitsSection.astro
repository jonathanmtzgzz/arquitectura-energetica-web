---
import TrendingUpIcon from '@/assets/svg/trending-up.svg';
import BuildingIcon from '@/assets/svg/building.svg';
import LeafIcon from '@/assets/svg/leaf.svg';
import BenefitCard from '@/components/BenefitCard.astro';
---

<section class='bg-[#FCF9F8] py-30'>
  <div class='flex flex-col items-center justify-center gap-16 px-5'>
    <h2
      class='text-primary text-center text-base leading-6 tracking-[1.6px] uppercase'
    >
      Beneficios a largo plazo
    </h2>
    <div class='flex w-87.5 flex-col gap-12'>
      <BenefitCard
        title='Corto Plazo'
        time='1-3 Años'
        description='Protección inmediata contra incrementos en tarifas de CFE y recuperación rápida de la inversión inicial.'
      >
        <TrendingUpIcon slot='icon' />
      </BenefitCard>
      <BenefitCard
        title='Mediano Plazo'
        time='5-10 Años'
        description='Ahorro acumulado significativo y aumento automático del valor de tu propiedad en el mercado.'
      >
        <BuildingIcon slot='icon' />
      </BenefitCard>
      <BenefitCard
        title='Largo Plazo'
        time='20-25 Años'
        description='Dos décadas de estabilidad económica energética y contribución activa a un futuro sostenible.'
      >
        <LeafIcon slot='icon' />
      </BenefitCard>
    </div>
  </div>
</section>
